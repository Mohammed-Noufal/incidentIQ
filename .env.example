# Copy this file to ".env" (same folder) and fill in the values.
# ".env" is git-ignored. Never commit real keys or passwords.
# Docker Compose and the Spring Boot app both read this file.
# Use plain KEY=value lines: no quotes, no spaces around "=".

# --- Server & CORS ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database (MySQL or local H2 fallback) ---
# To use MySQL:
DB_URL=jdbc:mysql://localhost:3306/incident_agent
DB_NAME=incident_agent
DB_USERNAME=incident
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
# To run without MySQL/Docker, uncomment H2 fallback:
# DB_URL=jdbc:h2:file:./data/incident_db;MODE=MySQL;DATABASE_TO_LOWER=TRUE;CASE_INSENSITIVE_IDENTIFIERS=TRUE;DB_CLOSE_DELAY=-1
# DB_USERNAME=sa
# DB_PASSWORD=

# --- Bootstrap Administrator Auth ---
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-admin
JWT_TTL_SECONDS=3600
# Base64-encoded 256-bit key (minimum 32 bytes)
JWT_SECRET=1q6KtHHsuXf4UxAmNgXSKVXZ3rUrNwYDrFZQ9CyTRk4=

# --- Dev convenience: insert three illustrative services on startup if the table is empty ---
APP_DEV_DATA=true

# --- External AI & Memory Services ---
# Do not paste real secrets into this template.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=incident-iq-demo
